<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#12422c">
<title>Ticklist</title>
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<link rel="stylesheet" href="style.css">
</head>
<body>
<header class="topbar">
  <div class="topbar-main"><h1>Ticklist</h1></div>
</header>
<main>
<ul class="challenge-list">
{% for c in challenges %}
  <li>
    <a href="{{ c.slug }}/">
      <span class="name">{{ c.name }}</span>
      <span class="meta">{{ c.routes|length }} routes · {{ c.routes|map(attribute='stars')|sum }} stars · {{ c.routes|map(attribute='height_m')|sum }} m</span>
    </a>
  </li>
{% endfor %}
</ul>
<p class="hint">Add to home screen for offline use. Everything is cached after first load.</p>
</main>
<script>
if ('serviceWorker' in navigator && location.hostname !== 'localhost') navigator.serviceWorker.register('./sw.js');
</script>
</body>
</html>
